---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CANON_PATHS, LINKS } from "../lib/links";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="Press Kit — Betsy AI | 2aBetsy"
  description="Press boilerplate, brand assets, and contact for Betsy AI / 2aBetsy by Coriolis Agency."
  path="/press"
  ogImagePath={CANON_PATHS.headshot}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <p
      class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400 mb-3"
    >
      Press
    </p>
    <h1 class="text-3xl font-semibold tracking-tight text-white mb-6">
      Press kit
    </h1>
    <div class="space-y-6 text-sm leading-relaxed text-zinc-400">
      <section>
        <h2 class="text-base font-semibold text-white mb-2">Boilerplate</h2>
        <p>
          Betsy AI is Coriolis Agency’s demand intelligence for lawful firearms
          commerce. She powers GunSearchAgent.com — free forever core Google
          Analytics replacement for FFL and 2A websites — My Betsy in-store
          hardware for the sales floor, multi-dealer search and Betsy Live on
          GunSearchEngine.com, Betsy Alerts for shopper restock watches, and
          Brand Intelligence for OEMs. Official brand home: 2aBetsy.com. Social:
          @2ABetsy (X), @BetsyAI (YouTube).
        </p>
      </section>
      <section>
        <h2 class="text-base font-semibold text-white mb-2">Contact</h2>
        <p>
          <a href={LINKS.pressEmail} class="text-sky-400 hover:underline"
            >betsy@coriolisagency.com</a
          >
        </p>
      </section>
      <section>
        <h2 class="text-base font-semibold text-white mb-2">Links</h2>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            Brand:{" "}
            <a href={LINKS.home} class="text-sky-400 hover:underline"
              >2aBetsy.com</a
            >
          </li>
          <li>
            Dealers:{" "}
            <a href={LINKS.gsa} class="text-sky-400 hover:underline"
              >GunSearchAgent.com</a
            >
          </li>
          <li>
            My Betsy (hardware):{" "}
            <a href={LINKS.myBetsy} class="text-sky-400 hover:underline"
              >gunsearchagent.com/my-betsy</a
            >
          </li>
          <li>
            Betsy Live:{" "}
            <a href={LINKS.betsyLive} class="text-sky-400 hover:underline"
              >gunsearchengine.com/betsy-live</a
            >
          </li>
          <li>
            Betsy Alerts (shopper watches):{" "}
            <a href={LINKS.betsyAlerts} class="text-sky-400 hover:underline"
              >gunsearchengine.com/mybetsy</a
            >
          </li>
          <li>
            Company:{" "}
            <a href={LINKS.coriolis} class="text-sky-400 hover:underline"
              >Coriolis Agency</a
            >
          </li>
        </ul>
      </section>
      <section>
        <h2 class="text-base font-semibold text-white mb-3">Headshot</h2>
        <img
          src={withBase(CANON_PATHS.headshot)}
          alt="Betsy AI headshot"
          width="320"
          height="320"
          class="w-40 rounded-2xl ring-1 ring-zinc-700"
        />
        <p class="mt-2 text-xs text-zinc-600">
          Canon stills for editorial use with credit “Betsy AI / Coriolis
          Agency.”
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
