---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CANON_PATHS, LINKS } from "../lib/links";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="Press Kit — Betsy AI | 2aBetsy"
  description="Press boilerplate, brand assets, and contact for Betsy AI / 2aBetsy by Coriolis Agency."
  path="/press"
  ogImagePath={CANON_PATHS.headshot}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <p
      class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400 mb-3"
    >
      Press
    </p>
    <h1 class="text-3xl font-semibold tracking-tight text-white mb-6">
      Press kit
    </h1>
    <div class="space-y-6 text-sm leading-relaxed text-zinc-400">
      <section>
        <h2 class="text-base font-semibold text-white mb-2">Boilerplate</h2>
        <p>
          Betsy AI is Coriolis Agency’s demand intelligence for lawful firearms
          commerce. She powers GunSearchAgent.com — free forever core Google
          Analytics replacement for FFL and 2A websites — My Betsy in-store
          hardware for the sales floor, multi-dealer search and Betsy Live on
          GunSearchEngine.com, Betsy Alerts for shopper restock watches, and
          Demand Intelligence for OEMs. Official brand home: 2aBetsy.com. Social:
          @2ABetsy (X), @BetsyAI (YouTube).
        </p>
      </section>
      <section>
        <h2 class="text-base font-semibold text-white mb-2">Contact</h2>
        <p>
          <a href={LINKS.pressEmail} class="text-sky-400 hover:underline"
            >betsy@coriolisagency.com</a
          >
        </p>
      </section>
      <section>
        <h2 class="text-base font-semibold text-white mb-2">Links</h2>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            Brand:{" "}
            <a href={LINKS.home} class="text-sky-400 hover:underline"
              >2aBetsy.com</a
            >
          </li>
          <li>
            Dealers:{" "}
            <a href={LINKS.gsa} class="text-sky-400 hover:underline"
              >GunSearchAgent.com</a
            >
          </li>
          <li>
            My Betsy (hardware):{" "}
            <a href={LINKS.myBetsy} class="text-sky-400 hover:underline"
              >gunsearchagent.com/my-betsy</a
            >
          </li>
          <li>
            Betsy Live:{" "}
            <a href={LINKS.betsyLive} class="text-sky-400 hover:underline"
              >gunsearchengine.com/betsy-live</a
            >
          </li>
          <li>
            Betsy Alerts (shopper watches):{" "}
            <a href={LINKS.betsyAlerts} class="text-sky-400 hover:underline"
              >gunsearchengine.com/mybetsy</a
            >
          </li>
          <li>
            Company:{" "}
            <a href={LINKS.coriolis} class="text-sky-400 hover:underline"
              >Coriolis Agency</a
            >
          </li>
        </ul>
      </section>
      <section>
        <h2 class="text-base font-semibold text-white mb-3">Assets</h2>
        <div class="flex flex-wrap gap-4 mb-3">
          <img
            src={withBase(CANON_PATHS.headshot)}
            alt="Betsy AI work headshot"
            width="320"
            height="400"
            class="w-36 rounded-2xl ring-1 ring-zinc-700"
          />
          <img
            src={withBase(CANON_PATHS.wordmark)}
            alt="Betsy wordmark"
            width="184"
            height="36"
            class="h-9 w-auto self-end"
          />
        </div>
        <p class="text-xs text-zinc-500 mb-3">
          Credit stills “Betsy AI / Coriolis Agency.” Header lockup: 36px work
          headshot + wordmark + one-line job.
        </p>
        <ul class="list-disc pl-5 space-y-1 text-xs text-zinc-500">
          <li>Work headshot — platform face, press, X avatar</li>
          <li>Wordmark — <code class="text-zinc-400">/brand/betsy-wordmark.svg</code></li>
          <li>Ink <code class="text-zinc-400">#0a1220</code> · panel <code class="text-zinc-400">#121a2b</code> · sky <code class="text-zinc-400">#0ea5e9</code></li>
        </ul>
      </section>
      <section>
        <h2 class="text-base font-semibold text-white mb-2">Do not use</h2>
        <ul class="list-disc pl-5 space-y-1">
          <li>Bikini / heat / feet stills or video</li>
          <li>Betsy Tzu (beard) as a press or OEM hero</li>
          <li>Demand Store “B” mark as her face</li>
          <li>“RetailBI alternative” as a headline</li>
          <li>Any claim that she files 4473s or runs NICS</li>
        </ul>
      </section>
      <section>
        <h2 class="text-base font-semibold text-white mb-2">Social</h2>
        <p>
          X <a href={LINKS.x} class="text-sky-400 hover:underline">@2ABetsy</a>
          {" "}
          is the Glance register (demand + shelf). YouTube{" "}
          <a href={LINKS.youtube} class="text-sky-400 hover:underline"
            >@BetsyAI</a
          >{" "}
          is Camera. Founder personal replies do not belong on her handle.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
