---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CANON_PATHS, LINKS } from "../lib/links";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="For Brands & OEMs — Brand Intelligence | Betsy AI"
  description="Brand Intelligence for firearms OEMs and platforms — anonymized demand and search intent powered by Betsy AI on GunSearchEngine."
  path="/for-brands"
  ogImagePath={CANON_PATHS.tzu}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <p
      class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400 mb-3"
    >
      For brands
    </p>
    <h1 class="text-3xl font-semibold tracking-tight text-white mb-4">
      Demand that manufacturers can use
    </h1>
    <p class="text-sm leading-relaxed text-zinc-400 mb-6">
      <strong class="text-zinc-200">Brand Intelligence</strong> sits on the same
      Betsy spine as dealer demand and shopper search — anonymized, plan-gated,
      built for OEMs and platforms. Not a dump of shopper emails.
    </p>
    <img
      src={withBase(CANON_PATHS.tzu)}
      alt="Art of Demand"
      width="960"
      height="540"
      class="mb-8 w-full rounded-2xl object-cover max-h-64 ring-1 ring-zinc-700/80"
    />
    <a
      href={LINKS.brandIntel}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex rounded-xl bg-sky-500 px-5 py-3 text-sm font-semibold text-slate-950 hover:bg-sky-400"
    >
      Brand Intelligence →
    </a>
    <p class="mt-6 text-xs text-zinc-600">
      Independent dealers start free on{" "}
      <a href={LINKS.gsa} class="text-sky-500 hover:underline">GunSearchAgent</a
      >. Network pulse:{" "}
      <a href={LINKS.betsyLive} class="text-sky-500 hover:underline"
        >Betsy Live</a
      >.
    </p>
  </article>
</BaseLayout>
