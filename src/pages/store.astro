---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CANON_PATHS, LINKS } from "../lib/links";
import { withBase } from "../lib/base";
import {
  fetchDemandStoreBootstrap,
  formatStorePrice,
  gseUpcSearchUrl,
  normalizeDemandStoreSections,
  type DemandStorePayload,
  type DemandStoreProduct,
} from "../lib/store";

/** Nightly snapshot baked into HTML at build — first paint has products. */
const bootstrap = await fetchDemandStoreBootstrap();
const sections = normalizeDemandStoreSections(bootstrap);
const totalPicks = sections.reduce((a, s) => a + s.products.length, 0);
const windowLabel =
  bootstrap?.windowLabel && /24\s*hour/i.test(bootstrap.windowLabel)
    ? bootstrap.windowLabel
    : "Last 24 hours";
const statusLine =
  totalPicks > 0
    ? `${totalPicks} live picks · ${windowLabel} · open GSE by UPC`
    : "Loading live shelf…";

const bootstrapJson = JSON.stringify(bootstrap ?? null).replace(
  /</g,
  "\\u003c"
);

function cardHref(p: DemandStoreProduct): string {
  return gseUpcSearchUrl(p.upc) || p.url;
}
---

<BaseLayout
  title="Betsy AI Store — Last 24h Demand | 2aBetsy"
  description="Automated gun & ammo shelf ranked by Betsy AI demand — Leaders and Trending merged per product type. Tap a card to open GunSearchEngine by UPC."
  path="/store"
  ogImagePath={CANON_PATHS.headshot}
  chrome={false}
  emailCapture={false}
>
  <script
    type="application/json"
    id="demand-store-bootstrap"
    set:html={bootstrapJson}
  />
  <div id="betsy-demand-store" class="store">
    <header class="store-header">
      <div class="store-header__panel">
        <div class="store-hero">
          <div class="store-hero__inner">
            <img
              src={withBase(CANON_PATHS.headshot)}
              alt=""
              width="48"
              height="48"
              class="store-hero__avatar"
            />
            <div class="store-hero__copy min-w-0">
              <p class="store-hero__kicker">
                Betsy AI · live demand · automated
              </p>
              <h1 class="store-hero__title">Demand Store</h1>
              <p class="store-hero__sub">
                Last 24 hours of network demand, ranked by Betsy. Tap a card →
                search GunSearchEngine by UPC. Not an FFL.
              </p>
              <p class="store-hero__status" data-store-status>
                {statusLine}
              </p>
            </div>
          </div>
        </div>

        <div class="store-chips-wrap" aria-label="Jump to product type">
          <div class="store-chips" data-store-chips>
            {
              sections.map((s) => (
                <a class="store-chip" href={`#section-${s.id}`}>
                  {s.label}
                  <span class="store-chip__n">{s.products.length}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </header>

    <div class="store-feed" data-store-feed aria-label="Demand by ATF type">
      {
        sections.map((s) => (
          <section
            class="store-section"
            id={`section-${s.id}`}
            aria-labelledby={`heading-${s.id}`}
            data-section-id={s.id}
          >
            <header class="store-section__head">
              <div class="store-section__titles">
                <h2 class="store-section__title" id={`heading-${s.id}`}>
                  {s.label}
                </h2>
                <p class="store-section__meta">
                  {s.products.length} picks · Leaders + Trending
                </p>
              </div>
            </header>
            <div class="store-grid" data-section-grid>
              {
                s.products.map((p) => {
                  const href = cardHref(p);
                  const badge =
                    p.badge === "hot"
                      ? "Hot"
                      : p.badge === "trending"
                        ? "Trending"
                        : null;
                  return (
                    <a
                      class="store-card"
                      href={href}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-product-id={p.product_id}
                      data-upc={p.upc}
                    >
                      <div class="store-card__media">
                        {p.image_url ? (
                          <img
                            src={p.image_url}
                            alt=""
                            loading="eager"
                            decoding="async"
                            class="store-card__img"
                            data-store-img
                          />
                        ) : (
                          <div class="store-card__ph" aria-hidden="true">
                            🎯
                          </div>
                        )}
                        {badge === "Hot" ? (
                          <span class="store-badge store-badge--hot">Hot</span>
                        ) : null}
                        {badge === "Trending" ? (
                          <span class="store-badge store-badge--trend">
                            Trending
                          </span>
                        ) : null}
                      </div>
                      <div class="store-card__body">
                        {p.brand ? (
                          <p class="store-card__brand">{p.brand}</p>
                        ) : null}
                        <h3 class="store-card__title">{p.title}</h3>
                        {p.caliber || p.type ? (
                          <p class="store-card__meta">
                            {[p.caliber, p.type].filter(Boolean).join(" · ")}
                          </p>
                        ) : null}
                        <div class="store-card__foot">
                          <div class="store-card__price-block">
                            <span class="store-card__from">from</span>
                            <span class="store-card__price">
                              {formatStorePrice(p.price)}
                            </span>
                          </div>
                          <span class="store-card__cta">Search GSE →</span>
                        </div>
                      </div>
                    </a>
                  );
                })
              }
            </div>
          </section>
        ))
      }
    </div>
    <p
      class="store-empty"
      data-store-empty
      hidden={totalPicks > 0}
    >
      {
        totalPicks > 0
          ? ""
          : "Loading nightly demand shelf…"
      }
    </p>

    <p class="store-disclaimer">
      Not a licensed FFL and not a cart. Cards open GunSearchEngine search by
      UPC (new tab). Purchases and transfers complete with licensed dealers on
      GSE or at the counter. Manufacturer names and images remain their owners’
      property; ranking does not imply endorsement. Powered by{" "}
      <a href={LINKS.gse} target="_blank" rel="noopener noreferrer"
        >GunSearchEngine</a
      >{" "}
      demand + live catalog. See also{" "}
      <a href={LINKS.betsyLive} target="_blank" rel="noopener noreferrer"
        >Betsy Live</a
      >. Brands:{" "}
      <a href={withBase("for-brands")}>category sponsorships</a>.
    </p>

    <div class="store-fab" role="group" aria-label="Store controls">
      <button
        type="button"
        class="store-fab__btn"
        data-store-filter
        title="Jump to type"
        aria-label="Jump to ATF type"
      >
        Types
      </button>
      <button
        type="button"
        class="store-fab__btn store-fab__btn--primary"
        data-store-refresh
        title="Reload shelf"
        aria-label="Reload shelf"
      >
        Refresh
      </button>
      <button
        type="button"
        class="store-fab__btn"
        data-store-top
        title="Back to top"
        aria-label="Back to top"
      >
        Top
      </button>
    </div>

    <div class="store-bottom">
      <p>Leaders + Trending · two rows per type · midnight ET refresh</p>
    </div>

    <div class="store-sheet" data-store-sheet hidden>
      <button
        type="button"
        class="store-sheet__scrim"
        data-store-sheet-scrim
        aria-label="Close"
      ></button>
      <div
        class="store-sheet__panel"
        role="dialog"
        aria-modal="true"
        aria-label="Jump to ATF type"
      >
        <div class="store-sheet__head">
          <p class="store-sheet__title">ATF types</p>
          <button
            type="button"
            class="store-sheet__close"
            data-store-sheet-close
            aria-label="Close"
          >
            Done
          </button>
        </div>
        <div class="store-sheet__list" data-store-sheet-list></div>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/demand-store.ts";
  </script>
</BaseLayout>

<style is:global>
  .store {
    --store-pad-x: 0.75rem;
    --store-max: 72rem;
    position: relative;
    max-width: var(--store-max);
    margin: 0 auto;
    padding: 0 0 calc(5.5rem + env(safe-area-inset-bottom, 0px));
    box-sizing: border-box;
  }

  /* Full header band — same width as product grid below */
  .store-header {
    padding:
      calc(1.25rem + env(safe-area-inset-top, 0px)) var(--store-pad-x) 0;
  }

  .store-header__panel {
    border-radius: 1.15rem;
    border: 1px solid rgb(63 63 70 / 0.85);
    background:
      radial-gradient(
        ellipse 90% 80% at 100% 0%,
        rgba(16, 185, 129, 0.1),
        transparent 55%
      ),
      radial-gradient(
        ellipse 70% 60% at 0% 0%,
        rgba(14, 165, 233, 0.08),
        transparent 50%
      ),
      linear-gradient(
        165deg,
        rgb(24 32 48 / 0.98),
        rgb(12 18 32 / 0.98)
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 10px 28px rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }

  .store-hero {
    padding: 1.1rem 1.1rem 0.85rem;
  }

  .store-hero__inner {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .store-hero__avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 0.85rem;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow:
      0 0 0 1px rgba(16, 185, 129, 0.4),
      0 6px 18px rgba(14, 165, 233, 0.18);
  }

  .store-hero__kicker {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(52 211 153);
  }

  .store-hero__title {
    margin: 0.25rem 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #fff;
    line-height: 1.15;
  }

  @media (min-width: 640px) {
    .store-hero__title {
      font-size: 1.5rem;
    }
  }

  .store-hero__sub {
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgb(161 161 170);
    max-width: 36rem;
  }

  .store-hero__status {
    display: inline-flex;
    margin: 0.65rem 0 0;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgb(56 189 248 / 0.28);
    background: rgb(12 74 110 / 0.28);
    font-size: 0.6875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: rgb(186 230 253);
    line-height: 1.3;
  }

  .store-chips-wrap {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: 0 0.65rem 0.75rem;
    border-top: 1px solid rgb(63 63 70 / 0.55);
    background: color-mix(in srgb, #0c1220 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .store-chips {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    gap: 0.4rem;
    overflow-x: auto;
    padding: 0.75rem 0.15rem 0.15rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .store-chips::-webkit-scrollbar {
    display: none;
  }

  .store-chip {
    flex: 0 0 auto;
    min-height: 2.15rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgb(63 63 70 / 0.95);
    background: rgb(24 24 27 / 0.92);
    color: rgb(228 228 231);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition:
      border-color 0.12s ease,
      background 0.12s ease;
  }

  .store-chip:hover {
    border-color: rgba(16, 185, 129, 0.45);
    background: rgba(16, 185, 129, 0.1);
  }

  .store-chip__n {
    font-size: 0.625rem;
    font-weight: 700;
    color: rgb(52 211 153);
    font-variant-numeric: tabular-nums;
    min-width: 1ch;
  }

  .store-feed {
    padding: 1rem var(--store-pad-x) 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .store-section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem 0.85rem;
    margin: 0 0 0.65rem;
    padding: 0 0.15rem;
  }

  .store-section__titles {
    min-width: 0;
    flex: 1 1 auto;
  }

  .store-section__title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fafafa;
  }

  .store-section__meta {
    margin: 0.15rem 0 0;
    font-size: 0.6875rem;
    font-weight: 600;
    color: rgb(113 113 122);
  }

  .store-section__empty {
    margin: 0;
    grid-column: 1 / -1;
    padding: 0.75rem 0.25rem;
    font-size: 0.8125rem;
    color: rgb(113 113 122);
  }

  /* Two visual rows: 4 columns desktop / 2 on small screens (max 8 cards). */
  .store-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  @media (min-width: 640px) {
    .store-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }

  .store-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: 1rem;
    border: 1px solid rgb(63 63 70 / 0.9);
    background: linear-gradient(
      165deg,
      rgb(24 32 48 / 0.98),
      rgb(12 18 32 / 0.98)
    );
    overflow: hidden;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 8px 24px rgba(0, 0, 0, 0.28);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) {
    .store-card:hover {
      border-color: rgba(14, 165, 233, 0.45);
      transform: translateY(-1px);
    }
  }

  .store-card:active {
    transform: scale(0.99);
  }

  .store-card--skeleton {
    min-height: 14rem;
    background: linear-gradient(
      90deg,
      rgb(24 24 27) 0%,
      rgb(39 39 42) 50%,
      rgb(24 24 27) 100%
    );
    background-size: 200% 100%;
    animation: store-shimmer 1.2s ease-in-out infinite;
  }

  @keyframes store-shimmer {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .store-card--skeleton {
      animation: none;
    }
    .store-card {
      transition: none;
    }
  }

  .store-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem;
    box-sizing: border-box;
    overflow: hidden;
  }

  .store-card__img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    margin: 0 auto;
    border-radius: 0.35rem;
    background: #ffffff;
  }

  .store-card__ph {
    font-size: 2rem;
    line-height: 1;
    opacity: 0.55;
    color: #71717a;
  }

  .store-badge {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    padding: 0.2rem 0.45rem;
    border-radius: 0.4rem;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: rgb(24 24 27 / 0.9);
    border: 1px solid rgb(63 63 70);
    color: rgb(212 212 216);
  }

  .store-badge--hot {
    border-color: rgba(251, 113, 133, 0.5);
    background: rgba(136, 19, 55, 0.75);
    color: rgb(254 205 211);
  }

  .store-badge--trend {
    border-color: rgba(52, 211, 153, 0.5);
    background: rgba(6, 78, 59, 0.8);
    color: rgb(167 243 208);
  }

  .store-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0.65rem 0.7rem;
    flex: 1;
    min-width: 0;
    min-height: 6.75rem;
  }

  .store-card__brand {
    margin: 0;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(125 211 252);
  }

  .store-card__title {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
    color: #fafafa;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* Reserve two lines so foot stays aligned across cards */
    min-height: calc(1.25em * 2);
  }

  .store-card__meta {
    margin: 0;
    font-size: 0.625rem;
    color: rgb(161 161 170);
  }

  .store-card__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.45rem;
  }

  .store-card__price-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.05rem;
    min-width: 0;
  }

  .store-card__from {
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: rgb(113 113 122);
    line-height: 1;
  }

  .store-card__price {
    font-size: 0.9375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: rgb(52 211 153);
    line-height: 1.15;
  }

  .store-card__cta {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 650;
    color: rgb(125 211 252);
    text-align: right;
    white-space: nowrap;
    flex-shrink: 0;
    line-height: 1.15;
    padding-bottom: 0.1rem;
  }

  .store-empty {
    margin: 1.5rem 0.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: rgb(161 161 170);
  }

  .store-disclaimer {
    margin: 0.25rem var(--store-pad-x) 1rem;
    font-size: 0.6875rem;
    line-height: 1.45;
    color: rgb(82 82 91);
  }

  .store-disclaimer a {
    color: rgb(56 189 248);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .store-fab {
    position: fixed;
    right: max(0.75rem, env(safe-area-inset-right));
    bottom: calc(3.25rem + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
  }

  .store-fab__btn {
    min-width: 4.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.9rem;
    border: 1px solid rgb(63 63 70);
    background: rgb(24 24 27 / 0.94);
    color: #f4f4f5;
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
  }

  .store-fab__btn--primary {
    border-color: rgba(16, 185, 129, 0.5);
    background: rgba(6, 78, 59, 0.92);
    color: rgb(167 243 208);
  }

  .store-fab__btn:disabled {
    opacity: 0.55;
  }

  .store-bottom {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 0.45rem 5.5rem 0.45rem 0.85rem;
    padding-bottom: calc(0.45rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid rgb(39 39 42 / 0.9);
    background: color-mix(in srgb, #0a1220 94%, transparent);
    backdrop-filter: blur(12px);
  }

  .store-bottom p {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(113 113 122);
  }

  .store-sheet {
    position: fixed;
    inset: 0;
    z-index: 60;
  }

  .store-sheet__scrim {
    position: absolute;
    inset: 0;
    border: 0;
    margin: 0;
    padding: 0;
    background: rgba(0, 0, 0, 0.55);
    cursor: pointer;
  }

  .store-sheet__panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: min(70dvh, 28rem);
    border-radius: 1.1rem 1.1rem 0 0;
    border: 1px solid rgb(63 63 70);
    border-bottom: 0;
    background: #0c1220;
    padding: 0.75rem 0.75rem
      calc(0.75rem + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.45);
  }

  .store-sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    padding: 0 0.25rem;
  }

  .store-sheet__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 650;
    color: #fff;
  }

  .store-sheet__close {
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(16, 185, 129, 0.45);
    background: rgba(16, 185, 129, 0.12);
    color: rgb(167 243 208);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .store-sheet__list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    overflow-y: auto;
    max-height: min(52dvh, 20rem);
  }

  .store-sheet-item {
    min-height: 3rem;
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    border-radius: 0.85rem;
    border: 1px solid rgb(63 63 70);
    background: rgb(24 24 27 / 0.85);
    color: #e4e4e7;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
