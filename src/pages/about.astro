---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import { CANON_PATHS, LINKS, linkClass } from "../lib/links";
import { withBase } from "../lib/base";

const ext = { target: "_blank", rel: "noopener noreferrer" };

const gsaPillars = [
  { href: LINKS.gsa, label: "GunSearchAgent" },
  { href: LINKS.gsaGa, label: "GA alternative for FFLs" },
  { href: LINKS.gsaDealers, label: "AI for gun dealers" },
  { href: LINKS.gsaGunStoreAi, label: "Gun store AI" },
  { href: LINKS.gsaHowTo, label: "How to install" },
] as const;

const gsePillars = [
  { href: LINKS.gse, label: "GunSearchEngine" },
  { href: LINKS.betsyLive, label: "Betsy Live" },
  { href: LINKS.superIntel, label: "Super Intelligence" },
  { href: LINKS.howTrains, label: "How Betsy trains Betsy" },
  { href: LINKS.ontology, label: "Ontology" },
  { href: LINKS.gseBetsy, label: "Betsy on GSE" },
  { href: LINKS.gunFriendly, label: "Gun-friendly AI" },
  { href: LINKS.whyRefuses, label: "Why AI refuses firearms" },
  { href: LINKS.brandIntel, label: "Brand Intelligence" },
] as const;

const pill =
  "inline-flex rounded-lg border border-zinc-700 bg-zinc-900/60 px-2.5 py-1.5 text-xs font-medium text-sky-300 transition hover:border-sky-500/50 hover:bg-sky-500/10 hover:text-sky-200";
---

<BaseLayout
  title="About Betsy AI | 2aBetsy"
  description="Who Betsy AI is, who built her, and what she is not — demand intelligence for lawful 2A commerce by Coriolis Agency."
  path="/about"
  ogImagePath={CANON_PATHS.headshot}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <p
      class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400 mb-3"
    >
      About
    </p>
    <h1 class="text-3xl font-semibold tracking-tight text-white mb-6">
      Who is Betsy?
    </h1>

    <!-- Full portrait — no object-cover / max-height crop -->
    <div class="mb-8 rounded-2xl ring-1 ring-zinc-700/80 bg-zinc-950/50 p-1 sm:p-2">
      <img
        src={withBase(CANON_PATHS.headshot)}
        alt="Betsy AI"
        width="640"
        height="800"
        class="mx-auto block h-auto w-full max-w-md rounded-xl"
      />
    </div>

    <div class="space-y-4 text-sm leading-relaxed text-zinc-400">
      <p>
        Betsy is{" "}
        <a href={LINKS.coriolis} class={linkClass} {...ext}>Coriolis Agency</a
        >’s <strong class="text-zinc-200">2A demand intelligence</strong> — a
        person-first brand for the tools that help{" "}
        <a href={LINKS.gsa} class={linkClass} {...ext}>dealers</a> measure real
        shopper intent on{" "}
        <a href={LINKS.gsa} class={linkClass} {...ext}>GunSearchAgent</a> and
        help{" "}
        <a href={LINKS.gse} class={linkClass} {...ext}>shoppers</a> find live
        inventory on{" "}
        <a href={LINKS.gse} class={linkClass} {...ext}>GunSearchEngine</a>
        {" "}
        without Big Tech refusal theater (
        <a href={LINKS.gunFriendly} class={linkClass} {...ext}>gun-friendly AI</a
        >,{" "}
        <a href={LINKS.whyRefuses} class={linkClass} {...ext}
          >why AI refuses firearms</a
        >).
      </p>
      <p>
        Named for Betsy Ross and the frontier “Old Betsy” rifles — craft and
        reliability when it counts. Built by{" "}
        <a href={LINKS.coriolis} class={linkClass} {...ext}>Coriolis Agency</a
        >{" "}
        for lawful 2A commerce.
      </p>

      <h2 class="pt-4 text-base font-semibold text-white">What she powers</h2>
      <ul class="list-disc space-y-3 pl-5">
        <li>
          <a href={LINKS.gsa} class={linkClass} {...ext}>GunSearchAgent</a>
          {" — "}
          free{" "}
          <a href={LINKS.gsaGa} class={linkClass} {...ext}
            >Google Analytics replacement</a
          >{" "}
          for FFL and 2A websites (
          <a href={LINKS.gsaDealers} class={linkClass} {...ext}
            >AI for gun dealers</a
          >,{" "}
          <a href={LINKS.gsaGunStoreAi} class={linkClass} {...ext}
            >gun store AI</a
          >,{" "}
          <a href={LINKS.gsaHowTo} class={linkClass} {...ext}>how to install</a
          >)
        </li>
        <li>
          <a href={LINKS.gse} class={linkClass} {...ext}>GunSearchEngine</a>
          {" — "}
          multi-dealer product search and network{" "}
          <a href={LINKS.betsyLive} class={linkClass} {...ext}>Betsy Live</a>
          {" "}
          demand insights (
          <a href={LINKS.superIntel} class={linkClass} {...ext}
            >Super Intelligence for FFLs</a
          >,{" "}
          <a href={LINKS.ontology} class={linkClass} {...ext}>Ontology</a>,{" "}
          <a href={LINKS.gseBetsy} class={linkClass} {...ext}>Betsy on GSE</a>)
        </li>
        <li>
          <a href={LINKS.brandIntel} class={linkClass} {...ext}
            >Brand Intelligence</a
          >
          {" — "}
          OEM / platform demand
        </li>
      </ul>

      <!-- Explicit pillar map (GSA / GSE) -->
      <div class="pt-2 space-y-4 not-prose">
        <div>
          <p
            class="text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-500 mb-2"
          >
            GunSearchAgent · dealer product
          </p>
          <div class="flex flex-wrap gap-1.5">
            {
              gsaPillars.map((p) => (
                <a href={p.href} class={pill} {...ext}>
                  {p.label}
                </a>
              ))
            }
          </div>
        </div>
        <div>
          <p
            class="text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-500 mb-2"
          >
            GunSearchEngine · platform & shoppers
          </p>
          <div class="flex flex-wrap gap-1.5">
            {
              gsePillars.map((p) => (
                <a href={p.href} class={pill} {...ext}>
                  {p.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <h2 class="pt-4 text-base font-semibold text-white">What she is not</h2>
      <ul class="list-disc space-y-2 pl-5">
        <li>Not ChatGPT with a gun sticker</li>
        <li>Not a price-scrape grid</li>
        <li>Not 4473 / NICS / bound-book automation</li>
        <li>Not a chatbot that lectures lawful shoppers</li>
      </ul>

      <p>
        Follow her on{" "}
        <a href={LINKS.x} class={linkClass} {...ext}>X @2ABetsy</a>
        {" "}
        and{" "}
        <a href={LINKS.youtube} class={linkClass} {...ext}>YouTube @BetsyAI</a
        >. Platform essays live on{" "}
        <a href={LINKS.gse} class={linkClass} {...ext}>GunSearchEngine</a>
        {" — "}
        including{" "}
        <a href={LINKS.howTrains} class={linkClass} {...ext}
          >how Betsy trains Betsy</a
        >{" "}
        and{" "}
        <a href={LINKS.superIntel} class={linkClass} {...ext}
          >Super Intelligence for FFLs</a
        >.
      </p>
    </div>
    <div class="mt-10">
      <CtaRow />
    </div>
  </article>
</BaseLayout>
